# ============================================
# AI-Microservices — Environment Configuration
# ============================================

# ── Google Gemini AI ──
GEMINI_API_KEY=Testing
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=2

# ── PYQ Backend API ──
PYQ_APPROVED_PAPERS_URL=http://localhost:8200/api/v1/questionPaper/getApprovedQuestionPapers

# ── MongoDB ──
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_microservices

# ── Server ──
APP_HOST=0.0.0.0
APP_PORT=8000
API_REQUEST_TIMEOUT=30

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=*

# ── JWT Authentication ──
JWT_SECRET_KEY="MYSECRET"
JWT_ALGORITHM=HS256
